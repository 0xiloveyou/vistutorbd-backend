<!doctype html>
<html>
  <body style="margin:0;padding:24px;background:#0b0b0b;color:#e5e7eb;font-family:Segoe UI,system-ui,sans-serif">
    <div style="max-width:560px;margin:0 auto;background:#111318;border:1px solid #262b36;border-radius:14px;padding:28px">
      <h1 style="margin:0 0 12px;color:#22c55e;font-size:22px">Password changed</h1>
      <p style="line-height:1.6">Hi <%= name %>, your password was updated successfully.</p>
      <p style="line-height:1.6;color:#9ca3af">If you did not make this change, reset your password again and contact an administrator.</p>
    </div>
  </body>
</html>
