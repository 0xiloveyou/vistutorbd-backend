<!doctype html>
<html lang="en">
  <body style="margin:0;padding:24px;background:#f5f6fb;color:#171b2c;font-family:Segoe UI,system-ui,sans-serif">
    <div style="max-width:640px;margin:0 auto;background:#ffffff;border:1px solid #dfe3ef;border-radius:16px;overflow:hidden">
      <div style="padding:24px 28px;background:#4f46e5;color:#ffffff">
        <p style="margin:0;font-size:12px;letter-spacing:.12em;text-transform:uppercase;opacity:.8">VizTutorBD &middot; visitor analytics</p>
        <h1 style="margin:8px 0 0;font-size:22px">Visitors for <%= label %></h1>
        <p style="margin:6px 0 0;opacity:.85;font-size:13px">Six-hour report &middot; timezone: <%= timezone %></p>
      </div>

      <div style="padding:28px">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin-bottom:22px">
          <tr>
            <td style="width:50%;padding:14px;border:1px solid #dfe3ef;border-radius:12px 0 0 12px;background:#eef2ff">
              <div style="font-size:12px;color:#5d647e;text-transform:uppercase;letter-spacing:.08em">Unique visitors</div>
              <div style="font-size:32px;font-weight:700;color:#4338ca"><%= visitors %></div>
            </td>
            <td style="width:50%;padding:14px;border:1px solid #dfe3ef;border-left:0;border-radius:0 12px 12px 0;background:#f8f9fd">
              <div style="font-size:12px;color:#5d647e;text-transform:uppercase;letter-spacing:.08em">Page views</div>
              <div style="font-size:32px;font-weight:700;color:#171b2c"><%= pageviews %></div>
            </td>
          </tr>
        </table>

        <% if (typeof lastSixHours !== "undefined" && lastSixHours) { %>
        <p style="margin:0 0 20px;padding:12px 14px;border-radius:10px;background:#e5f8f0;color:#0e9468;font-size:14px">
          Last 6 hours: <strong><%= lastSixHours.visitors %></strong> unique visitor(s), <strong><%= lastSixHours.pageviews %></strong> page view(s).
        </p>
        <% } %>

        <h2 style="margin:0 0 10px;font-size:15px">Top pages</h2>
        <% if (topPages.length === 0) { %>
          <p style="margin:0 0 20px;color:#5d647e;font-size:14px">No visits recorded for this day yet.</p>
        <% } else { %>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin-bottom:20px;font-size:13px">
            <% topPages.forEach((page) => { %>
              <tr>
                <td style="padding:9px 0;border-bottom:1px solid #eef1f9;color:#171b2c;word-break:break-all"><%= page.path %></td>
                <td style="padding:9px 0;border-bottom:1px solid #eef1f9;text-align:right;color:#5d647e;white-space:nowrap"><%= page.count %> view(s)</td>
              </tr>
            <% }) %>
          </table>
        <% } %>

        <p style="margin:0;color:#5d647e;font-size:12px;line-height:1.6">
          Signed-in visitors: <strong><%= signedInVisitors %></strong><br />
          Report generated: <%= generatedAt %><br />
          Open the site: <a href="<%= frontendUrl %>" style="color:#4f46e5"><%= frontendUrl %></a>
        </p>
      </div>
    </div>
  </body>
</html>
