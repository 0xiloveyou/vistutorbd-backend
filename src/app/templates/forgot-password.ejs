<!doctype html>
<html>
  <body style="margin:0;padding:24px;background:#0b0b0b;color:#e5e7eb;font-family:Segoe UI,system-ui,sans-serif">
    <div style="max-width:560px;margin:0 auto;background:#111318;border:1px solid #262b36;border-radius:14px;padding:28px">
      <h1 style="margin:0 0 12px;color:#fca5a5;font-size:22px">Reset your password</h1>
      <p style="line-height:1.6">Hi <%= name %>, use this one-time code to choose a new password.</p>
      <div style="margin:24px 0;padding:18px;text-align:center;border-radius:10px;background:#0b0b0b;border:1px dashed #fca5a5">
        <span style="font-size:34px;letter-spacing:10px;color:#facc15;font-weight:700"><%= otp %></span>
      </div>
      <p style="line-height:1.6;color:#9ca3af">This code expires in <%= expirationMinutes %> minutes.</p>
    </div>
  </body>
</html>
