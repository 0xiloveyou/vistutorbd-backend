# ---------------------------------------------------------------------------
# Math Learning Platform â€” backend environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# MongoDB Atlas (free M0)
# Prisma 6.19 is pinned because Prisma 7 has no stable MongoDB connector.
# Apply the schema with `npm run db:push` (MongoDB does not use migrations).
# ---------------------------------------------------------------------------
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/mathlearn?retryWrites=true&w=majority&appName=Cluster0"

BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Seed bands/levels/templates/admin accounts on startup only when missing.
AUTO_SEED=true

BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Google OAuth (ID-token login + authorization-code callback)
# Authorized redirect URI: http://localhost:3000/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ---------------------------------------------------------------------------
# SMTP (use a Gmail App Password if SMTP_HOST is empty)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional. When unset, OTP/session/rate-limit helpers use an in-memory store.
REDIS_URL=
# Alternatively:
REDIS_USER=
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# OpenRouter (server-side only; keys never reach the browser)
# Free model availability changes: keep the list in env, not in code.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODELS=model-a:free,model-b:free
OPENROUTER_FALLBACK_CHAT_MODELS=model-c:free,model-d:free
OPENROUTER_VISION_MODEL=
OPENROUTER_FALLBACK_VISION_MODELS=
OPENROUTER_EMBEDDING_MODEL=

# openrouter | local | stub (stub works with no key and is the dev default)
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384

# Chat messages per user/IP per hour.
CHAT_RATE_LIMIT_PER_HOUR=30

# ---------------------------------------------------------------------------
# Visitor analytics + six-hour email report
# ---------------------------------------------------------------------------
# Cron expression for the visitor report. Default: every six hours.
VISITOR_REPORT_CRON=0 */6 * * *
# "Today" is calculated in this timezone.
REPORT_TIMEZONE=Asia/Dhaka
# Contact-form destination. Falls back to ADMIN_EMAIL.
CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Seeded accounts (idempotent)
# ---------------------------------------------------------------------------
ADMIN_NAME=Math Admin
ADMIN_EMAIL=care.1337.leet@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

MODERATOR_NAME=Math Moderator
MODERATOR_EMAIL=ahammedm.shakil@gmail.com,sifatasifasif@gmail.com
MODERATOR_PASSWORD=@9.

USER_NAME=Demo Learner
USER_EMAIL=sifatasif99@gmail.com
USER_PASSWORD=User@12345

# Original JSON lessons kept as format reference for the legacy import phase.
LEGACY_JSON_DIR=./reference-data/legacy-json

