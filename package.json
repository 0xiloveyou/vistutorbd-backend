{
  "name": "math-learning-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API for the Math Learning Platform: auth, roles, taxonomy, topics, visualizations, quiz, chat, RAG knowledge, OpenRouter, Redis, SMTP, cron jobs and MongoDB via Prisma.",
  "scripts": {
    "dev": "tsx watch --include .env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/app/lib/__tests__/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx src/app/scripts/seed.ts",
    "library:sync": "tsx src/app/scripts/library-sync.ts",
    "figure:pages": "bun src/app/scripts/export-figures-pages.ts",
    "figure:extract": "bun src/app/scripts/extract-figures.ts",
    "figure:link": "bun src/app/scripts/link-figures.ts",
    "figure:validate": "bun src/app/scripts/validate-figures.ts",
    "content:validate": "tsx src/app/scripts/validate-visualizations.ts",
    "content:archive": "tsx src/app/scripts/archive-legacy.ts",
    "format:check": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "lint:check": "biome lint ./src",
    "lint:fix": "biome lint --write ./src"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "mathjs": "^14.9.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "redis": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.4",
    "mupdf": "^1.28.6",
    "prisma": "^6.19.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
